  .cmr .touch button {
    position: absolute;
    pointer-events: auto;
    touch-action: none;
    text-align: center;
    font-size: 12px;
    font-weight: 700;
    color: var(--light);
    background: rgba(29, 33, 34, 0.35);
    border: 1px solid rgba(242, 244, 238, 0.55);
  }

  .cmr .touch button.on {
    background: rgba(242, 244, 238, 0.35);
  }

  .touch [data-k='left'] { left: 14px; top: 392px; width: 68px; height: 72px; }
  .touch [data-k='right'] { left: 90px; top: 392px; width: 68px; height: 72px; }
  .touch [data-k='hand'] { left: 444px; top: 236px; width: 56px; height: 44px; }
  .touch [data-k='brake'] { left: 444px; top: 288px; width: 56px; height: 70px; }
  .touch [data-k='gas'] { left: 508px; top: 236px; width: 72px; height: 122px; }
  .touch [data-k='pause'] { left: 436px; top: 14px; width: 40px; height: 34px; }

  /* Driving controls in the pillarbox bars (wide touch screens) */
  .cmr-frame > .touch {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    --gap: 12px;
  }

  .cmr-frame > .touch button {
    position: absolute;
    inset: auto;
    pointer-events: auto;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    font-family: 'Archivo', 'Helvetica Neue', Arial, sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: #f2f4ee;
    background: rgba(141, 150, 149, 0.16);
    border: 1px solid rgba(242, 244, 238, 0.5);
    border-radius: 0;
    padding: 0;
  }

  .cmr-frame > .touch button.on {
    background: rgba(242, 244, 238, 0.32);
  }

  .cmr-frame > .touch [data-k='left'],
  .cmr-frame > .touch [data-k='right'] {
    bottom: calc(var(--gap) * 1.5);
    width: calc((min(var(--bar), 220px) - var(--gap) * 3) / 2);
    height: min(46vh, 170px);
    font-size: 22px;
  }

  .cmr-frame > .touch [data-k='left'] {
    left: var(--gap);
  }

  .cmr-frame > .touch [data-k='right'] {
    left: calc(var(--gap) * 2 + (min(var(--bar), 220px) - var(--gap) * 3) / 2);
  }

  .cmr-frame > .touch [data-k='gas'] {
    right: var(--gap);
    bottom: calc(var(--gap) * 1.5);
    width: calc((min(var(--bar), 220px) - var(--gap) * 3) * 0.55);
    height: min(58vh, 210px);
  }

  .cmr-frame > .touch [data-k='brake'] {
    right: calc(var(--gap) * 2 + (min(var(--bar), 220px) - var(--gap) * 3) * 0.55);
    bottom: calc(var(--gap) * 1.5);
    width: calc((min(var(--bar), 220px) - var(--gap) * 3) * 0.45);
    height: min(34vh, 120px);
  }

  .cmr-frame > .touch [data-k='hand'] {
    right: calc(var(--gap) * 2 + (min(var(--bar), 220px) - var(--gap) * 3) * 0.55);
    bottom: calc(var(--gap) * 2.5 + min(34vh, 120px));
    width: calc((min(var(--bar), 220px) - var(--gap) * 3) * 0.45);
    height: min(18vh, 64px);
  }

  .cmr-frame > .touch [data-k='pause'] {
    right: var(--gap);
    top: var(--gap);
    width: 48px;
    height: 40px;
  }

