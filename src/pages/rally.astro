---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experience } from '../data/experience';

import '../styles/theme.css';
import '../styles/global.css';

// Rally-flavored extras keyed by organization; the substance comes from experience.ts
const extras: Record<string, { country: string; surface: string; notes: string }> = {
  'Center for Research and Training on Substance Use-HIV, Hanoi Medical University': {
    country: 'VNM',
    surface: 'Tarmac / Monsoon',
    notes: 'Funding transition, 2025. Long drop over crest, minus sixty-five. Seven years of records, keep it clean.',
  },
  'The Water Institute at UNC': {
    country: 'USA',
    surface: 'Gravel',
    notes: 'Long straight, 50 countries. Webinar crest, flat out. Build the road as you drive it.',
  },
  'FHI 360': {
    country: 'USA',
    surface: 'Mixed',
    notes: 'Handwashing hairpin left. Evidence over crest into field guidance, keep in.',
  },
  'USAID': {
    country: 'USA',
    surface: 'Tarmac (Federal)',
    notes: 'Compliance chicane, twenty-plus country teams. Keep tight through the subawards.',
  },
  'Pathfinders for Greenways': {
    country: 'USA',
    surface: 'Greenway',
    notes: 'Blue Ridge loop. Newsletter over jump, 4,000 copies, maintain.',
  },
};

const stages = [
  ...experience.map((e) => ({
    name: e.organization.replace(/^Center for Research and Training on Substance Use-HIV, /, ''),
    role: e.role,
    dates: e.dateRange,
    location: e.location,
    description: e.description,
    ...(extras[e.organization] ?? { country: '---', surface: 'Unknown', notes: 'No recce.' }),
  })),
  {
    name: 'Duke Kunshan University',
    role: 'B.S. Global Health & Public Policy',
    dates: '2021 — 2025',
    location: 'Kunshan, China',
    description: 'Three years living and studying in China, alongside a B.A. from Duke. Thesis used topic modeling on 2,300+ USAID documents to track how U.S. global health priorities shifted between administrations.',
    country: 'CHN',
    surface: 'Mixed / Mandarin',
    notes: 'Long stage abroad. Policy written here lands over there. Watch the crest.',
  },
];
---

<BaseLayout
  title="Liam Powell — Rally Mode"
  description="Career mode. Same résumé, different interface."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
    <link
      href="https://fonts.googleapis.com/css2?family=Exo+2:ital,wght@1,600;1,800;1,900&family=Share+Tech+Mono&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <div class="rally">
    <header class="rally-top">
      <div class="logo">
        <span class="logo-small">Liam Powell</span>
        <span class="logo-big">RALLY <em>2.0</em></span>
      </div>
      <div class="mode">Career Mode · Season 2026</div>
    </header>

    <main class="rally-main">
      <section class="panel stage-list" aria-label="Stage select">
        <h1 class="panel-title">Stage Select</h1>
        <ol id="stages">
          {stages.map((s, i) => (
            <li>
              <button class="stage" data-i={i} aria-pressed={i === 0 ? 'true' : 'false'}>
                <span class="stage-num">SS{String(i + 1).padStart(2, '0')}</span>
                <span class="stage-name">{s.name}</span>
                <span class="stage-cc">{s.country}</span>
              </button>
            </li>
          ))}
        </ol>
      </section>

      <section class="panel stage-info" aria-live="polite">
        {stages.map((s, i) => (
          <article class="info" data-i={i} hidden={i !== 0}>
            <h2 class="info-name">{s.name}</h2>
            <p class="info-role">{s.role}</p>
            <dl class="info-grid">
              <div><dt>Location</dt><dd>{s.location}</dd></div>
              <div><dt>Stage time</dt><dd>{s.dates}</dd></div>
              <div><dt>Surface</dt><dd>{s.surface}</dd></div>
            </dl>
            <p class="info-desc">{s.description}</p>
            <div class="pacenotes">
              <span class="pacenotes-label">Co-driver</span>
              <p>“{s.notes}”</p>
            </div>
          </article>
        ))}
      </section>
    </main>

    <footer class="rally-bottom">
      <span><kbd>↑</kbd><kbd>↓</kbd> Select stage</span>
      <a href="/resume.pdf"><kbd>C</kbd> Full CV</a>
      <a href="/"><kbd>Esc</kbd> Back to the normal site</a>
    </footer>
  </div>

  <script is:inline>
    (function () {
      const buttons = Array.from(document.querySelectorAll('.stage'));
      const infos = Array.from(document.querySelectorAll('.info'));
      let current = 0;

      function select(i, focus) {
        current = (i + buttons.length) % buttons.length;
        buttons.forEach((b, j) => b.setAttribute('aria-pressed', j === current ? 'true' : 'false'));
        infos.forEach((el, j) => (el.hidden = j !== current));
        if (focus) buttons[current].focus();
      }

      buttons.forEach((b, i) => {
        b.addEventListener('click', () => select(i));
        b.addEventListener('mouseenter', () => select(i));
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 's') { e.preventDefault(); select(current + 1, true); }
        else if (e.key === 'ArrowUp' || e.key === 'w') { e.preventDefault(); select(current - 1, true); }
        else if (e.key === 'Escape') { window.location.href = '/'; }
        else if (e.key === 'c') { window.location.href = '/resume.pdf'; }
      });
    })();
  </script>
</BaseLayout>

<style is:global>
  body:has(.rally) {
    background: #06122e;
  }
</style>

<style>
  .rally {
    --navy: #06122e;
    --blue: #123d8a;
    --cyan: #5fd3ff;
    --yellow: #ffd200;
    --chrome: linear-gradient(180deg, #ffffff 0%, #c9d6e8 45%, #6f84a6 52%, #e8eef7 100%);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    color: #e8eef7;
    font-family: 'Share Tech Mono', ui-monospace, monospace;
    background:
      repeating-linear-gradient(-60deg, transparent 0 22px, rgba(95, 211, 255, 0.04) 22px 24px),
      radial-gradient(ellipse at 70% 0%, #1f5ccc 0%, transparent 60%),
      linear-gradient(180deg, #0b2a6b 0%, var(--navy) 70%);
    overflow-x: hidden;
  }

  .rally-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    padding: 1.5rem clamp(1rem, 4vw, 3rem) 1rem;
    border-bottom: 3px solid var(--yellow);
  }

  .logo {
    display: flex;
    flex-direction: column;
    font-family: 'Exo 2', sans-serif;
    font-style: italic;
    line-height: 0.9;
  }

  .logo-small {
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 0.35rem;
  }

  .logo-big {
    font-weight: 900;
    font-size: clamp(2.6rem, 9vw, 4.5rem);
    letter-spacing: -0.02em;
    background: var(--chrome);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(3px 3px 0 #000) drop-shadow(0 0 12px rgba(95, 211, 255, 0.35));
  }

  .logo-big em {
    font-style: italic;
    background: linear-gradient(180deg, #fff6b0, var(--yellow) 50%, #d97a00 52%, #ffd200);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .mode {
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--yellow);
  }

  .rally-main {
    flex: 1;
    display: grid;
    gap: 1.5rem;
    padding: 1.5rem clamp(1rem, 4vw, 3rem);
  }

  @media (min-width: 860px) {
    .rally-main {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      align-items: start;
    }
  }

  .panel {
    background: linear-gradient(180deg, rgba(18, 61, 138, 0.55), rgba(6, 18, 46, 0.85));
    border: 2px solid rgba(95, 211, 255, 0.5);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.6), 0 0 24px rgba(31, 92, 204, 0.35);
    clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 18px 100%, 0 calc(100% - 18px));
    padding: 1.25rem;
    min-width: 0;
  }

  .panel-title {
    font-family: 'Exo 2', sans-serif;
    font-style: italic;
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 1rem;
  }

  ol {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .stage {
    width: 100%;
    display: grid;
    grid-template-columns: 3.2rem 1fr auto;
    gap: 0.75rem;
    align-items: center;
    text-align: left;
    padding: 0.6rem 0.8rem;
    background: rgba(0, 0, 0, 0.25);
    border: none;
    color: #e8eef7;
    font: inherit;
    cursor: pointer;
    transform: skewX(-10deg);
    transition: background 0.12s, color 0.12s;
  }

  .stage > * {
    transform: skewX(10deg);
  }

  .stage[aria-pressed='true'] {
    background: linear-gradient(90deg, var(--yellow), #ff9d00);
    color: #06122e;
  }

  .stage:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }

  .stage-num {
    font-size: 0.8rem;
    opacity: 0.75;
  }

  .stage-name {
    font-family: 'Exo 2', sans-serif;
    font-style: italic;
    font-weight: 800;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .stage-cc {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }

  .info-name {
    font-family: 'Exo 2', sans-serif;
    font-style: italic;
    font-weight: 900;
    font-size: clamp(1.5rem, 3.5vw, 2.2rem);
    line-height: 1.05;
    text-transform: uppercase;
    background: var(--chrome);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(2px 2px 0 #000);
    margin-bottom: 0.4rem;
  }

  .info-role {
    color: var(--yellow);
    margin-bottom: 1.25rem;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .info-grid div {
    background: rgba(0, 0, 0, 0.35);
    border-left: 3px solid var(--cyan);
    padding: 0.5rem 0.7rem;
  }

  dt {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  dd {
    font-size: 0.95rem;
  }

  .info-desc {
    line-height: 1.6;
    color: #c9d6e8;
    margin-bottom: 1.25rem;
  }

  .pacenotes {
    border: 1px dashed rgba(255, 210, 0, 0.6);
    padding: 0.75rem 0.9rem;
  }

  .pacenotes-label {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--yellow);
    margin-bottom: 0.3rem;
  }

  .pacenotes p {
    font-style: italic;
  }

  .rally-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    padding: 1rem clamp(1rem, 4vw, 3rem) 1.5rem;
    border-top: 3px solid var(--yellow);
    background: rgba(0, 0, 0, 0.4);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .rally-bottom a {
    color: #e8eef7;
    text-decoration: none;
  }

  .rally-bottom a:hover {
    color: var(--yellow);
  }

  kbd {
    display: inline-block;
    min-width: 1.6em;
    padding: 0.05em 0.35em;
    margin-right: 0.3em;
    border: 1px solid var(--cyan);
    border-radius: 3px;
    color: var(--cyan);
    font: inherit;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .stage { transition: none; }
  }
</style>
